+  /**
+   * Move the camera to a place, on request from an external assistant.
+   *
+   * Added locally for the JARVIS voice bridge. Goes through flyTo and then
+   * setView, the same pair _restoreCamera uses, so the result is a view the
+   * app considers its own: the share hash will describe this position, and
+   * copying the URL out of the address bar gives a link to this place.
+   *
+   * @param {{lat?:number,lon?:number,height?:number,label?:string}} detail
+   */
+  jarvisFocus(detail) {
+    if (this._destroyed || !detail) return false;
+    const lat = Number(detail.lat);
+    const lon = Number(detail.lon);
+    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return false;
+    const height = Number.isFinite(Number(detail.height))
+      ? Number(detail.height)
+      : 400000;
+    let view;
+    try {
+      // fromDegrees with an object literal, matching how the rest of the app
+      // builds a destination. The first version of this built a Cartographic
+      // and passed it to fromRadians, which wants radians not an object --
+      // Cesium rejected it with "Expected longitude to be typeof number,
+      // actual typeof was object" and the camera never moved.
+      view = {
+        destination: Cesium.Cartesian3.fromDegrees(lon, lat, height),
+      };
+    } catch (error) {
+      console.error('[jarvis-focus] destination failed', error);
+      return false;
+    }
+    try {
+      this.viewer.camera.flyTo({
+        ...view,
+        duration: 3.0,
+        easingFunction: Cesium.EasingFunction.CUBIC_IN_OUT,
+        complete: () => {
+          if (!this._destroyed) {
+            this.viewer.camera.setView(view);
+            this.viewer.scene?.requestRender?.();
+          }
+        },
+      });
+    } catch (error) {
+      console.error('[jarvis-focus] flyTo failed', error);
+      try {
+        this.viewer.camera.setView(view);
+      } catch {
+        return false;
+      }
+    }
+    return true;
+  }
